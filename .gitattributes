# 统一换行符, 避免 Windows clone 出现 CRLF
*                       text=auto eol=lf

# 显式标记二进制
*.png                  binary
*.jpg                  binary
*.jpeg                 binary
*.gif                  binary
*.ico                  binary
*.svg                  binary
*.woff                 binary
*.woff2                binary

# shell 脚本强制 LF
*.sh                   text eol=lf
install.sh             text eol=lf
lib/*.sh               text eol=lf

# Lua 强制 LF
*.lua                  text eol=lf

# 配置文件
*.toml                 text eol=lf
*.yml                  text eol=lf
*.yaml                 text eol=lf
*.json                 text eol=lf
*.kdl                  text eol=lf

# diff 友好
*.md                   text eol=lf
.gitignore             text eol=lf
.gitattributes         text eol=lf
.editorconfig          text eol=lf
LICENSE                text eol=lf